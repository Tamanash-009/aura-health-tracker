{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Spring Boot Check",
            "request": "launch",
            "cwd": "${workspaceFolder}/backend",
            "mainClass": "com.aurahealth.AuraHealthApplication",
            "projectName": "backend",
            "args": "",
            "env": {
                "SPRING_PROFILES_ACTIVE": "dev"
            }
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Frontend",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/frontend/src"
        }
    ],
    "compounds": [
        {
            "name": "Full Stack Debug",
            "configurations": [
                "Spring Boot Check",
                "Launch Frontend"
            ]
        }
    ]
}